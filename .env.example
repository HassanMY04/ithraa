# API settings (read by apps/api; prefix ITHRAA_)
ITHRAA_DATABASE_URL=postgresql+psycopg://ithraa:ithraa@localhost:5432/ithraa
ITHRAA_JWT_SECRET=change-me
ITHRAA_CORS_ORIGINS=http://localhost:5173
ITHRAA_UPLOAD_DIR=uploads

# Demo mode: one-click "view as" logins and a clock frozen at the seeded date.
# Set ITHRAA_DEMO_MODE=false (and ITHRAA_DEMO_NOW=) for real use.
ITHRAA_DEMO_MODE=true
ITHRAA_DEMO_NOW=2026-10-21T18:30:00
